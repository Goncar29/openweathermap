{
  "name": "openweathermap",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.js\"",
    "lint": "prettier --check \"src/**/*.js\"",
    "test": "vitest",
    "test:run": "vitest run",
    "pre-commit": "pretty-quick --staged",
    "install:husky": "husky install",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "husky": "^9.1.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.2",
    "pretty-quick": "^3.1.0",
    "sass": "^1.99.0",
    "vite": "^5.4.0",
    "vite-plugin-sass": "^0.1.0",
    "vitest": "^2.0.0"
  },
  "homepage": "https://Goncar29.github.io/openweathermap",
  "vitest": {
    "testEnvironment": "jsdom",
    "globals": true
  }
}
